NODE_ENV=production
PORT=3000

# Nunca pongas "#" suelto en la contraseña dentro de la URL sin comillas: el .env lo toma como comentario.
# Opción A — codificar # como %23:
DATABASE_URL=postgresql://usuario:claveCon%23Almohadilla@host:5432/nombre_bd
# Opción B — comillas en toda la URL:
# DATABASE_URL="postgresql://usuario:claveCon#Almohadilla@host:5432/nombre_bd"

# Solo si otros scripts lo necesitan; la API Node no usa PG_PASSWORD.
# PG_PASSWORD="claveCon#Almohadilla"

# En la nube casi siempre true (evita error "no encryption" / pg_hba).
DB_SSL=true

JWT_SECRET=cambiar_por_secreto_seguro_min_8_chars
JWT_EXPIRES_IN=8h

# Opcionales (despliegue / scripts; la API no las lee).
# CPLUS_BACKEND_CONTEXT=./prod/concreplus
# CPLUS_BACKEND_DIR=./prod/concreplus/back

# --- Local (ejemplo): comenta el bloque de arriba y usa ---
# NODE_ENV=development
# PORT=3000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concreto_db
# DB_SSL=false
